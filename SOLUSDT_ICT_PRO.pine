//@version=6

strategy(

     title="SOLUSDT ICT PRO Strategy V1.2",

     shorttitle="ICT PRO V1.2",

     overlay=true,

     pyramiding=0,

     initial_capital=100000,

     commission_type=strategy.commission.percent,

     commission_value=0.05,

     calc_on_every_tick=false,

     process_orders_on_close=true,

     max_labels_count=500,

     max_lines_count=500,

     max_boxes_count=500

)

groupGeneral = "General"

enableStrategy = input.bool(
     true,
     "Enable Strategy",
     group = groupGeneral)

showDebug = input.bool(
     false,
     "Debug Mode",
     group = groupGeneral)

//////////////////////////////////////////////////////////////////////////////
// MODULE ENGINE
//////////////////////////////////////////////////////////////////////////////

groupModule = "Modules"

useBiasEngine      = input.bool(true, "4H Bias", group=groupModule)
useLiquidityEngine = input.bool(true, "PDH / PDL", group=groupModule)
useCRTEngine       = input.bool(true, "CRT Sweep", group=groupModule)
useTurtleSoup      = input.bool(true, "Turtle Soup", group=groupModule)
useMSSEngine       = input.bool(true, "MSS", group=groupModule)
useCISDEngine      = input.bool(true, "CISD", group=groupModule)
useOTEEngine       = input.bool(true, "OTE", group=groupModule)
useFVGEngine       = input.bool(true, "FVG", group=groupModule)
useOBEngine        = input.bool(true, "Order Block", group=groupModule)

//////////////////////////////////////////////////////////////////////////////
// RISK
//////////////////////////////////////////////////////////////////////////////

groupRisk = "Risk"

riskPercent = input.float(
     1.0,
     "Risk %",
     minval = 0.1,
     step = 0.1,
     group = groupRisk)

riskReward = input.float(
     2.0,
     "Risk : Reward",
     minval = 1.0,
     step = 0.5,
     group = groupRisk)

//////////////////////////////////////////////////////////////////////////////
// ALERT
//////////////////////////////////////////////////////////////////////////////

groupAlert = "Alert"

enableAlert = input.bool(
     true,
     "Enable Alert",
     group = groupAlert)

useWebhook = input.bool(
     true,
     "Webhook",
     group = groupAlert)

useTelegram = input.bool(
     false,
     "Telegram",
     group = groupAlert)

telegramChatID = input.string(
     "",
     "Telegram Chat ID",
     group = groupAlert)
//////////////////////////////////////////////////////////////////////////////
// ENGINE VARIABLES
//////////////////////////////////////////////////////////////////////////////

var bool bullBias = false
var bool bearBias = false

var bool longSignal = false
var bool shortSignal = false

var float entryPrice = na
var float stopLoss = na
var float takeProfit = na

//////////////////////////////////////////////////////////////////////////////
// ALERT JSON
//////////////////////////////////////////////////////////////////////////////

buyMessage =
     '{"signal":"BUY",' +
     '"symbol":"' + syminfo.ticker + '",' +
     '"price":"' + str.tostring(close) + '"}'

sellMessage =
     '{"signal":"SELL",' +
     '"symbol":"' + syminfo.ticker + '",' +
     '"price":"' + str.tostring(close) + '"}'

//////////////////////////////////////////////////////////////////////////////
// DEBUG
//////////////////////////////////////////////////////////////////////////////

plotshape(
     showDebug and bullBias,
     title="Bull Bias",
     style=shape.circle,
     location=location.belowbar,
     color=color.green,
     size=size.tiny)

plotshape(
     showDebug and bearBias,
     title="Bear Bias",
     style=shape.circle,
     location=location.abovebar,
     color=color.red,
     size=size.tiny)

//////////////////////////////////////////////////////////////////////////////
// VERSION LABEL
//////////////////////////////////////////////////////////////////////////////

var label versionLabel = na

if barstate.islast
    if not na(versionLabel)
        label.delete(versionLabel)

    versionLabel := label.new(
         bar_index,
         high,
         "SOLUSDT ICT PRO\nV1.2",
         style=label.style_label_down,
         textcolor=color.white,
         color=color.new(color.blue, 70))
plot(close, title="Close")
//////////////////////////////////////////////////////////////////////////////
// BIAS ENGINE
//////////////////////////////////////////////////////////////////////////////

groupBias = "4H Bias"

biasTF = input.timeframe(
     "240",
     "Bias Timeframe",
     group = groupBias)

biasFastEMA = input.int(
     50,
     "Fast EMA",
     minval = 1,
     group = groupBias)

biasSlowEMA = input.int(
     200,
     "Slow EMA",
     minval = 1,
     group = groupBias)
biasEMA50 =
     request.security(
          syminfo.tickerid,
          biasTF,
          ta.ema(close, biasFastEMA),
          lookahead = barmerge.lookahead_off)

biasEMA200 =
     request.security(
          syminfo.tickerid,
          biasTF,
          ta.ema(close, biasSlowEMA),
          lookahead = barmerge.lookahead_off)
if useBiasEngine

    bullBias := biasEMA50 > biasEMA200

    bearBias := biasEMA50 < biasEMA200
plot(
     showDebug ? biasEMA50 : na,
     title="4H EMA50",
     color=color.lime)

plot(
     showDebug ? biasEMA200 : na,
     title="4H EMA200",
     color=color.orange)
bgcolor(
     showDebug
     ? bullBias
          ? color.new(color.green,92)
          : bearBias
               ? color.new(color.red,92)
               : na
     : na)
//////////////////////////////////////////////////////////////////////////////
// LIQUIDITY ENGINE
//////////////////////////////////////////////////////////////////////////////

groupLiquidity = "Liquidity"

showPDH = input.bool(true, "Show PDH", group=groupLiquidity)
showPDL = input.bool(true, "Show PDL", group=groupLiquidity)

showLiquidityDebug = input.bool(
     false,
     "Liquidity Debug",
     group=groupLiquidity)
//////////////////////////////////////////////////////////////////////////////
// PREVIOUS DAY
//////////////////////////////////////////////////////////////////////////////

pdh =
     request.security(
          syminfo.tickerid,
          "D",
          high[1],
          lookahead=barmerge.lookahead_off)

pdl =
     request.security(
          syminfo.tickerid,
          "D",
          low[1],
          lookahead=barmerge.lookahead_off)
plot(
     showPDH ? pdh : na,
     title="PDH",
     color=color.red,
     linewidth=2)

plot(
     showPDL ? pdl : na,
     title="PDL",
     color=color.green,
     linewidth=2)
bullSweep =
     low < pdl and close > pdl

bearSweep =
     high > pdh and close < pdh
plotshape(
     showLiquidityDebug and bullSweep,
     title="Bull Sweep",
     style=shape.triangleup,
     color=color.lime,
     location=location.belowbar)

plotshape(
     showLiquidityDebug and bearSweep,
     title="Bear Sweep",
     style=shape.triangledown,
     color=color.red,
     location=location.abovebar)

plot(
     showPDH ? pdh : na,
     title="PDH",
     color=color.red,
     linewidth=2)

plot(
     showPDL ? pdl : na,
     title="PDL",
     color=color.green,
     linewidth=2)
bullSweep =
     low < pdl and close > pdl

bearSweep =
     high > pdh and close < pdh
plotshape(
     showLiquidityDebug and bullSweep,
     title="Bull Sweep",
     style=shape.triangleup,
     color=color.lime,
     location=location.belowbar)

plotshape(
     showLiquidityDebug and bearSweep,
     title="Bear Sweep",
     style=shape.triangledown,
     color=color.red,
     location=location.abovebar)
